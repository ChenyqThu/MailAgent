{
  "name": "mailagent-frontend",
  "version": "1.14.0",
  "description": "MailAgent macOS Electron desktop client (V1)",
  "main": "./out/main/index.js",
  "author": "chenyqthu",
  "homepage": "https://github.com/chenyqthu/MailAgent",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "icon:fetch": "node scripts/fetch-animated-icon.mjs",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "pnpm rebuild:node && vitest run",
    "test:watch": "pnpm rebuild:node && vitest",
    "start": "electron-vite preview",
    "dev": "pnpm rebuild:electron && electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts && BUILD_SW=1 vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "a11y:contrast": "tsx scripts/a11y/contrast.ts --strict",
    "a11y:contrast:json": "tsx scripts/a11y/contrast.ts --json",
    "postinstall": "electron-builder install-app-deps && pnpm gen:types",
    "rebuild:node": "node -e \"const p=require('path'),cp=require('child_process'),root=process.cwd();try{cp.execFileSync(p.join(root,'node_modules/.pnpm/node_modules/.bin/prebuild-install'),['--runtime=node','--arch=arm64'],{cwd:p.join(root,'node_modules/.pnpm/better-sqlite3@12.10.0/node_modules/better-sqlite3'),stdio:'inherit'})}catch(e){if(e.status===null){console.error('prebuild-install completed but exited with signal; binary should be in place')}else{throw e}}\" && codesign --sign - --force node_modules/.pnpm/better-sqlite3@12.10.0/node_modules/better-sqlite3/build/Release/better_sqlite3.node",
    "rebuild:electron": "node -e \"const p=require('path'),cp=require('child_process'),root=process.cwd();try{cp.execFileSync(p.join(root,'node_modules/.pnpm/node_modules/.bin/prebuild-install'),['--runtime=electron','--target=39.8.10','--arch=arm64'],{cwd:p.join(root,'node_modules/.pnpm/better-sqlite3@12.10.0/node_modules/better-sqlite3'),stdio:'inherit'})}catch(e){if(e.status===null){console.error('prebuild-install completed but exited with signal; binary should be in place')}else{throw e}}\" && codesign --sign - --force node_modules/.pnpm/better-sqlite3@12.10.0/node_modules/better-sqlite3/build/Release/better_sqlite3.node",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:mac": "pnpm build:web && pnpm rebuild:electron && electron-vite build && electron-builder --mac",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "gen:types": "tsx scripts/gen-types.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-mention": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extensions": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/suggestion": "^3.23.6",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.3",
    "execa": "^9.6.1",
    "keytar": "^7.9.0",
    "ms": "2.1.3",
    "node-html-parser": "^7.1.0",
    "rrule": "^2.8.1",
    "which": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.7",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@assistant-ui/react": "^0.14.24",
    "@assistant-ui/react-ai-sdk": "^1.3.38",
    "@assistant-ui/react-lexical": "0.2.4",
    "@axe-core/playwright": "^4.11.3",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@gsap/react": "^2.1.2",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "ai": "^7.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.3",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gsap": "^3.15.0",
    "happy-dom": "^20.9.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-icu": "^2.4.3",
    "json-schema-to-typescript": "^15.0.4",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.0",
    "ogl": "^1.0.11",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.8",
    "react-window": "^2.2.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.6",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3",
      "keytar"
    ],
    "overrides": {
      "@assistant-ui/react": "0.14.24",
      "@assistant-ui/core": "0.2.19",
      "@assistant-ui/store": "0.2.19",
      "@assistant-ui/tap": "0.9.3",
      "@assistant-ui/react-ai-sdk": "1.3.38"
    }
  }
}
