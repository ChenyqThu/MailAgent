# MailAgent 环境变量配置
# 复制此文件为 .env 并填入你的配置
#
# 翻 flag 何时生效（三档载体，见 docs/plans/architecture-review-2026-07/e3-config-governance.md）：
#   1) pydantic 冷读（src/config.py 绝大多数 Field）：进程启动读一次 → 改后**重启** main.py /
#      serve-api 生效。
#   2) dotenv_values 热读（少数经 serve-api /chat/config 的 `_hot_bool`，如
#      MAILAGENT_STANDING_CONTEXT_ENABLED / MAILAGENT_MEM0_RETRIEVAL）：**保存 .env 即时生效**，
#      无需重启。
#   3) Node main env（前端 gateway 的 envBool，如 MAILAGENT_OPENNESS_* / MAILAGENT_SKILL_SELF_MOUNT）：
#      gateway spawn 时注入 → 改后**重启 app** 生效。

# =============================================================================
# Notion 配置 (必填)
# =============================================================================
NOTION_TOKEN=ntn_your_token_here
EMAIL_DATABASE_ID=your_email_database_id
CALENDAR_DATABASE_ID=your_calendar_database_id

# =============================================================================
# Mail.app 配置 (applescript backend 必填 ; davmail backend 仍读 USER_EMAIL)
# =============================================================================
USER_EMAIL=your.email@example.com
MAIL_ACCOUNT_NAME=Exchange
MAIL_INBOX_NAME=收件箱
MAIL_SENT_NAME=已发送邮件

# =============================================================================
# Dual-Backend 配置 (Sprint 16 cutover 起, 2026-05-22 生产路径 = davmail)
# 详见 docs/sprint16-cutover-complete.md + docs/dual-backend-architecture-handoff.md
# =============================================================================
# 主 backend 选择: applescript (macOS Mail.app + AppleScript) | davmail (IMAP/SMTP 桥)
# 默认 applescript ; 生产环境 = davmail
MAILAGENT_BACKEND=applescript

# issue #34: 切 backend 时防 marker (last_max_row_id) id-space 混用。
# marker 在 applescript 是 Mail.app ROWID、在 davmail 是 IMAP UID，跨切换复用会让增量取号
# 越过巨大 UID 空窗 → 静默丢数据 / 卡死。on (默认) = 切 backend 时把 marker 重定基线到当前
# backend (只向前不回捞)、首次部署遇既有 marker 认领不重置。off = 回退旧 (bug) 行为。
# MAILAGENT_MARKER_BACKEND_GUARD=true

# DavMail JVM 监听地址 (本机 PM2 进程 davmail-poc)
# DAVMAIL_HOST=127.0.0.1

# davmail-poc 部署目录绝对路径 (watchdog 读 token/token.dat + logs/davmail.log)。
# 留空 = 仓库根/davmail-poc (pm2 dev 模式 OK)；打包 .app 必须配绝对路径，
# 否则看板 DavMail OAuth Token 状态恒"未知"。
# DAVMAIL_ROOT=/absolute/path/to/MailAgent/davmail-poc

# DavMail 端口 (跟 davmail-poc/config/davmail.properties 一致)
# DAVMAIL_IMAP_PORT=1143
# DAVMAIL_SMTP_PORT=1025

# IMAP/SMTP 登录用户名 (邮箱地址, 通常同 USER_EMAIL)
# DAVMAIL_USER=your.email@example.com

# StringEncryptor 密码, 跟本机 davmail.properties 的 cipher key 一致
# 生产模式下必填 ; 留空 + DAVMAIL_POC_MODE=1 时 fallback 共享 PoC key
# DAVMAIL_POC_CIPHER_KEY=

# PoC 模式 fallback: 1=用默认 'mailagent-poc-shared-key' (**非生产**), 0=必须显式配 CIPHER_KEY
# DAVMAIL_POC_MODE=0

# IMAP 端 inbox 文件夹名 (Microsoft 365 通常 'INBOX')
# DAVMAIL_INBOX_NAME=INBOX

# Drafts folder 名 (留空自动 SPECIAL-USE detection, fallback 顺序: Drafts/已保存/草稿)
# DAVMAIL_DRAFTS_NAME=

# =============================================================================
# 邮件同步配置
# =============================================================================
# 同步起始日期 (只同步此日期之后的邮件到 Notion)
SYNC_START_DATE=2026-01-01

# 要同步的邮箱列表（逗号分隔）
SYNC_MAILBOXES=收件箱,发件箱

# === 多文件夹同步（davmail-only）===
# 额外同步的自定义 Exchange 文件夹白名单。存 IMAP 原始名 (modified-UTF7, ASCII)。
# 🔴 用 **JSON 数组** 格式 —— modified-UTF7 中文名本身含逗号 (base64 段, 如 对话历史记录=
#   &W,mL3VOGU,KLsF9V-)，逗号分隔会拆坏。简单 ASCII 名仍兼容旧逗号分隔。
# 空 = 不同步任何自定义文件夹（默认，零激活，行为与现状逐字节一致）。
# 收件箱/发件箱由 SYNC_MAILBOXES 管，不在此列。用 `mailagent folder discover` 查可用文件夹的
# imap_name；用 `mailagent folder enable/disable <imap_name>`（自动写 JSON）增删。改后需
# pm2 restart mail-sync。
# 例: SYNC_FOLDERS=["Notion","Jira","DMS&VvpO9lPRXgM-","&W,mL3VOGU,KLsF9V-"]
SYNC_FOLDERS=
# 自定义文件夹首次同步窗口（最近 N 天），防大文件夹历史邮件灌爆
FOLDER_SYNC_PAST_DAYS=90
# 单个自定义文件夹单次拉取上限（取最新 N 封）；0=不限
FOLDER_SYNC_MAX_MESSAGES=2000
# L2/L3 per-folder 处理开关（按 mailbox 显示名匹配，JSON 数组；PRD §2.3 分层）
# 通知降噪（L3）：自定义文件夹**默认不刷飞书**；仅此白名单内的文件夹通知。空=全不通知。
# 例: FOLDER_NOTIFY_ENABLED=["Jira"]
FOLDER_NOTIFY_ENABLED=
# AI 分类（L2）：自定义文件夹**默认跑 LLM**；此黑名单内的跳过（省成本去噪）。空=全分类。
# 例: FOLDER_LLM_DISABLED=["Jira","Bugzilla"]
FOLDER_LLM_DISABLED=

# === 草稿箱同步（davmail-only）===
# 同步 Exchange 草稿箱到本地 (mailbox='草稿箱')，给前端侧边栏草稿箱入口/数量用。
# 草稿仅入本地 SQLite（列表/数量/正文/FTS），不进 Notion / LLM / 飞书 / KOS。
# 全量 UID 对账：编辑/发送/删除导致的草稿消失会同步删除本地行。AppleScript 模式不激活。
DRAFTS_SYNC_ENABLED=true

# 雷达轮询间隔 (秒)，检测新邮件
RADAR_POLL_INTERVAL=5

# =============================================================================
# AppleScript 配置
# =============================================================================
# 每批获取邮件数量（初始化同步用，建议 10-50）
INIT_BATCH_SIZE=10

# AppleScript 超时时间（秒）
APPLESCRIPT_TIMEOUT=200

# =============================================================================
# 日历同步配置 (可选，calendar_main.py 使用)
# =============================================================================
CALENDAR_NAME=日历
# applescript backend：本机 Calendar.app（AppleScript / EventKit）
CALENDAR_SYNC_MODE=eventkit
CALENDAR_PAST_DAYS=7
CALENDAR_FUTURE_DAYS=15
# davmail backend：CalDAV → SQLite SSoT（CalendarSyncWorker）。applescript 模式忽略以下项
CALENDAR_CALDAV_SYNC_ENABLED=false
CALENDAR_CALDAV_SYNC_POLL_INTERVAL_SEC=60
CALENDAR_CALDAV_SYNC_WINDOW_PAST_DAYS=30
CALENDAR_CALDAV_SYNC_WINDOW_FUTURE_DAYS=180

# 周期会议滚动展开（main.py loop）
# 间隔（秒）：默认 1 天滚动展开一次
# MEETING_EXPANSION_INTERVAL_SECONDS=86400
# 展开未来窗口（周）：默认 4 周
# MEETING_EXPANSION_HORIZON_WEEKS=4

# =============================================================================
# 飞书通知配置 (可选)
# =============================================================================
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=your_chat_id
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=
# FEISHU_NOTIFY_ENABLED=false

# =============================================================================
# Redis 事件消费配置 (可选，启用 Notion→Mail 反向事件驱动)
# =============================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_DB=2
# REDIS_EVENTS_ENABLED=false

# =============================================================================
# 看板统计上报配置 (可选，启用远程监控看板)
# =============================================================================
# STATS_REPORT_URL=https://mailagent.chenge.ink/api/stats/report
# STATS_REPORT_INTERVAL=60
# STATS_REPORT_TOKEN=your_webhook_secret_here

# =============================================================================
# 飞书告警机器人配置 (可选，PM2 运行时推荐启用)
# =============================================================================
# ALERT_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id
# ALERT_FEISHU_WEBHOOK_SECRET=your_secret
# ALERT_ENABLED=false
# 告警级别: critical,error,warning,info（逗号分隔）
# ALERT_LEVELS=critical,error,warning
# 同类告警冷却时间（秒），避免刷屏
# ALERT_COOLDOWN=300
# dead_letter 累积告警阈值
# ALERT_DEAD_LETTER_THRESHOLD=5

# =============================================================================
# 防锁屏保活配置 (可选，防止 MDM 自动锁屏)
# =============================================================================
# KEEP_ALIVE_ENABLED=false
# 保活时自动调低屏幕亮度
# KEEP_ALIVE_DIM=true

# =============================================================================
# 周项目同步（外挂模块，默认全部关闭）
# =============================================================================
# 这是一个通用的"邮件附件 xlsx → Notion 数据库"的同步外挂，最早为 Evelyn
# 每周的 RD Project Progress Report 邮件设计，但所有过滤条件都抽到配置里，
# 其他团队/BU 也可以复用（写自己的数据库 ID + BU 过滤 + 发件人 + 标题正则）。
#
# 默认全部关闭，其他协作者拉取代码后 CLI 和钩子都不会运行。
# 本地启用步骤：
#   1) 填入 PROJECT_PROGRESS_DATABASE_ID（目标 Notion 数据库）
#   2) 调整 PROJECT_PROGRESS_FILTER_BU（xlsx 保留的 BU 值，如 TPS-ENBU / TPS-HNBU）
#   3) 配置 PROJECT_PROGRESS_SUBJECT_PATTERN（识别哪封邮件）；
#      PROJECT_PROGRESS_SENDER 是可选过滤（留空则不限制发件人，推荐——实际发件人会换人）
#   4) 设 PROJECT_PROGRESS_SYNC_ENABLED=true（总开关，必须）
#   5) 若想让主服务检测到邮件后自动触发，再设 PROJECT_PROGRESS_AUTO_SYNC_ENABLED=true（可选）
#   6) pm2 restart mail-sync（钩子模式）或 CLI 手动运行
#
# S5 W5a 起：项目周报同步已迁入 Agents 页（DB v31 播种 type='project_progress' 单例行）。
#   - SUBJECT_PATTERN / SENDER / AUTO_SYNC_ENABLED 三项在首次迁移时**播种进行**，之后
#     Settings → Agents → 项目周报同步 可改（行权威，改这里的 env 不再影响已播种的行）。
#   - PROJECT_PROGRESS_SYNC_ENABLED 仍是**总闸**（env，非 UI；总闸未开时行存在但不运行），
#     PROJECT_PROGRESS_DATABASE_ID / FILTER_BU 仍是 env 权威（Settings 只读展示）。
#   - 执行仍走确定性 runner（xlsx→Notion），不进 gateway / async_jobs。

# 总开关（必须显式打开，CLI 和钩子都依赖它；S5 后仍是总闸，Settings 不覆盖）
# PROJECT_PROGRESS_SYNC_ENABLED=false

# Notion 目标数据库 ID（留空则禁用）
# 数据库需含以下 property（参见 CLAUDE.md "字段映射"）:
#   核心：项目名称 (title) / external_id (rich_text) / 本周数据期 (rich_text) /
#         优先级 (select) / BU (select) / 研发分部 (select) / Product Models (multi_select) /
#         产品线 (multi_select) / 美国发货 (checkbox) / PM 协助PM 接口人 风险项 (rich_text) /
#         参考 DDL 项目开始时间 (date) / Status (status) / 母任务 子任务 (self-relation dual_property) /
#         Evelyn 原邮件 (url)
#   v2 新增 7 个 (schema bootstrap 启动时自动创建): 立项时间 / 期望交期 / 预计出货 /
#         实际出货 / 暂停时间 (date) / 进度异常 (rich_text) / 当前状态 (select)
#   Status 需手动加 "Suspended" 选项（API 不支持，必须 Notion 后台手工添加）
# 例：https://www.notion.so/omadanetworks/6f528975839940ceaacaf545e47cf25d
# PROJECT_PROGRESS_DATABASE_ID=6f528975839940ceaacaf545e47cf25d

# 过滤保留的 BU 值（精确匹配 xlsx BU 列；例 TPS-ENBU / TPS-HNBU / TPS-CEBU）
# PROJECT_PROGRESS_FILTER_BU=TPS-ENBU

# 识别邮件的标题正则。S5 起仅作**首次迁移 seed 默认**（行落地后 Settings 权威）。代码 default 留空。
# PROJECT_PROGRESS_SUBJECT_PATTERN=<subject regex (e.g., 【项目进度】研发项目deadline汇报.*)>

# 可选: 识别邮件的发件人（子串匹配，不区分大小写）。S5 起同样仅作首次迁移 seed 默认（行权威）。
# 留空 → 仅按 subject 匹配（推荐，实际发件人会变动）
# 配置 → 双判定（sender + subject 都要匹配）
# PROJECT_PROGRESS_SENDER=<weekly-sender-email>

# 主服务检测到匹配邮件后是否自动触发同步（非阻塞）。
# S5 起仅作**首次迁移 seed 默认**：迁移时刻的值播种进行的 enabled 列，之后 Settings 的启用开关
# 权威（改这里的 env 不再影响已播种的行）。仍需 PROJECT_PROGRESS_SYNC_ENABLED 总闸同时开。
# PROJECT_PROGRESS_AUTO_SYNC_ENABLED=false

# =============================================================================
# LLM Agent（本地 LLM 接管 Notion Custom Agent 的 AI 字段填充，默认关闭）
# =============================================================================
# ⚠️ 启用前必须先到 Notion automation 把 Email Agent 改成 disabled，
#    或加"AI Summary is empty"过滤条件，避免本地 LLM 与 Notion AI 双跨撞车。
#
# 启用步骤：
#   1) 填 LLM_API_KEY（建议 https://crs.chenge.ink 的 cr_ 开头 key）
#   2) 填 LLM_CONTEXT_PAGE_ID（参照 Email Agent Context 页面，或复制到自己的 workspace）
#   3) 可选：填 LLM_DAILY_DIGEST_DATABASE_ID 启用 Daily Digest relation
#   4) 按需改 prompt（默认在 prompts/email_inbox.md / prompts/email_sent.md）
#   5) LLM_AGENT_ENABLED=true
#   6) Notion automation 暂停 Email Agent
#   7) pm2 restart mail-sync

# LLM_AGENT_ENABLED=false
# LLM_API_BASE=https://crs.chenge.ink/api
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-6
# LLM_MAX_TOKENS=64000
# LLM_TIMEOUT_SEC=60

# 07-01 memory.md 自动抽取记忆（auto-capture）总开关（默认开 —— 2026-07-02 cutover，设 false
# 可关，应急回退）。开后每个 chat turn 完成时 Node
# gateway onFinish fire-and-forget 调 serve-api /chat/memory/capture → 读现 memory.md + 本轮 →
# 一次 LLM 调用（MEMORY_CAPTURE_MODEL，默认 haiku）把持久偏好/事实合并进有界 memory.md
# （agent_config.db 的 MEMORY doc；去重 + 超 MEMORY_MD_BUDGET_CHARS 则斟酌淘汰最不重要/过时的条目
# 压回预算）。全本地，邮件衍生数据不出第三方 SaaS（抽取 LLM 经内部 CRS）。fire-and-forget、绝不
# 阻塞 TTFT/SSE。由 Electron main 进程（gateway lifecycle）读，非 config.py pydantic。
# MAILAGENT_MEM0_CAPTURE=true

# memory.md auto-capture 合并/淘汰用的模型名（经内部 CRS）。默认 claude-haiku-4-5（便宜快，每轮
# 对话调一次做合并，opus 太贵）；填值可覆盖（Settings「记忆抽取模型」下拉也可设）。仅
# MAILAGENT_MEM0_CAPTURE 开时生效。由 config.py pydantic 读：翻需重启 serve-api。
# MEMORY_CAPTURE_MODEL=claude-haiku-4-5

# memory.md 硬字符预算（默认 5000）。auto-capture 合并后若超此预算 → 同 MEMORY_CAPTURE_MODEL 斟酌
# 淘汰最不重要/过时的条目压回；memory.md 恒注入每轮 system prompt（MAILAGENT_MEM0_RETRIEVAL 开时），
# 故预算越大 = 每轮 token 成本越高。由 config.py pydantic 读：翻需重启 serve-api。
# MEMORY_MD_BUDGET_CHARS=5000

# 07-01 memory.md 恒注入总开关（默认开 —— 2026-07-02 cutover，设 false 可关，应急回退；语义从
# M2「按 query 召回」改为「恒注入有界 memory.md」）。
# 开后每个 chat turn 把 memory.md（auto-capture 策展的持久事实）经 /chat/config 的 memorySummary
# 注入 system prompt（现成 MEMORY fence，untrusted 背景，在可缓存 stable 前缀内 → prefix-cache 稳定）
# —— 不再按 query 向量召回。关 或 memory.md 空 → memorySummary="" → 不注入（字节级 flag-off）。
# 由 serve-api /chat/config 热读 .env（改即时生效，无需重启）。
# MAILAGENT_MEM0_RETRIEVAL=true

# M3 user.md 偏好编译总开关（默认开 —— 2026-07 cutover，设 false 可关，应急回退）。开后
# Settings「从记忆编译偏好」按钮可见 + serve-api
# /chat/memory/compile-user-md 放行：load_memory_md（memory.md）→ LLM 合并现有 user.md（保留手编）
# + memory.md 偏好候选 → set_profile_doc('user', agent_proposed)（恒注入身份文档，history/rollback
# 兜底）。手动触发、非 hot-path。🔴 由 config.py pydantic 读：翻 flag 需重启 serve-api。
# MAILAGENT_USER_MD_COMPILE=true

# Settings 身份文档编辑器开关（默认开）。AI tab 出现「身份文档」section，列出 SOUL/AGENT/RULES/USER
# 4 个文档，支持查看 + 手动编辑 + 版本历史/rollback。关后 section 字节级不渲染。
# 由 config.py pydantic 读：翻 flag 需重启 serve-api。
# MAILAGENT_STANDING_DOCS_EDITOR=true

# M4a skill→tool 门控总开关（默认开 —— 2026-07-02 cutover，设 false 可关，应急回退）。on 时
# embedded AI SDK Gateway 的工具注册受 skill
# 启用态驱动：关掉某 skill（Settings）其读工具不再注册给模型（收 cutover 后「关了 skill 工具仍可调」
# 真 bug）。Python /chat/config.advertisedSkills（哪些 skill 可见=业务态）+ Node applySkillGating
# （gateway 工具→skill 映射+过滤=工具集结构）。范围=email/search/report 读工具；email_search +
# kos/memory/write/send 永不门控。🔴 由 Electron main 进程 gateway 读（同 MEM0_CAPTURE/RETRIEVAL，
# 非 config.py pydantic，不加 vite define）。off → gateway 工具集字节级同 cutover。
# MAILAGENT_SKILL_SELF_MOUNT=true

# S1 开放性第一波 R1：会话检索工具（E3 cutover 默认开 2026-07-06；显式 false 应急回退）。开时前端 chat 多轮 agent（AI SDK Gateway）多 3 个
# silent 读工具 chat_session_list / chat_session_search / chat_session_get —— agent 可检索/读取
# 自己的历史会话（ai_chat.db，FTS5 trigram 中文子串可搜；返回内容恒套 UNTRUSTED_CHAT_HISTORY
# 围栏，历史会话含邮件引用=二阶注入面）。🔴 由 Electron main 进程 gateway 读（同
# MAILAGENT_ISLAND_AGENT_ENABLED，非 config.py pydantic，不加 vite define）。off → gateway
# 工具集字节级同 v1.2.0。会话 FTS 表（CHAT_DB_VERSION 17）不受此 flag 门控（additive 迁移恒跑）。
# MAILAGENT_OPENNESS_SESSION_TOOLS=true

# S1 开放性第一波 R2：配置读写工具（E3 cutover 默认开 2026-07-06；显式 false 应急回退）。开时 gateway 多 4 个工具：agent_profile_read /
# agent_profile_history（silent 读——读 SOUL/AGENT/RULES/USER/memory 全文+版本历史；memory 返回
# 恒套 UNTRUSTED_MEMORY 围栏，身份文档原文=与 standing context 注入一致）+ agent_profile_restore /
# agent_memory_update（edit-tier 写恒人审，auto-reversible 也不跳卡；restore 回滚到历史版本，RULES
# 目标内容服务端重过 validate_rules_content 拒越权版本复活；memory 更新走 Python 硬字符预算闸）。
# 🔴 由 Electron main 进程 gateway 读（同上，非 config.py pydantic，不加 vite define）。off →
# gateway 工具集字节级同 v1.2.0。
# MAILAGENT_OPENNESS_CONFIG_TOOLS=true

# S1 开放性第一波 R3：联网工具（E3 cutover 默认开 2026-07-06；显式 false 应急回退）。开时 gateway 多 2 个工具：web_fetch（抓一个 http/https
# 页面正文，HTML→markdown）+ web_search（DuckDuckGo 搜索，best-effort）。🔴 均 edit-tier **恒人审**
# （外发网络绝不自动执行，auto-reversible 也不跳卡；批准时可改 url/query）。执行在 Python serve-api
# /api/web/*（业务权威 + 远程 parity）：SSRF 防护（拒 loopback/私网/link-local/reserved + DNS 解析后
# 钉死已校验 IP 防 rebinding + 逐跳 redirect 重校验 + size/time/content-type cap）。返回内容恒套
# UNTRUSTED_WEB_CONTENT 围栏（网页内容=注入面）。由 Electron main 进程 gateway 读（同上，非 config.py
# pydantic，不加 vite define）。off → gateway 工具集字节级同 v1.2.0。
# MAILAGENT_OPENNESS_WEB_TOOLS=true

# S2 执行能力 R5：本机执行工具（E3 cutover 默认开 2026-07-06；显式 false 应急回退，安全地板不变：无白名单命中恒 HITL）。开时 gateway 多 3 个工具：run_command（跑一条本机命令，
# 显式 argv 无 shell）+ file_read（读本机文件正文）+ file_write（写本机文件）。🔴 均 edit-tier **恒人审**
# （本机执行绝不自动，auto-reversible 也不跳卡；批准时可改 argv/cwd/path/content）—— 除非 owner 经审批卡
# 「总是允许」或 Settings 设了**结构化白名单** PolicyRule 命中（argv 模板 + realpath 前缀，非字符串），命中
# 才免卡（needsApproval 前置调 /api/agent/policy/evaluate 传服务端可信 contextMode；ask/超时/异常一律 fail-closed
# 弹卡）。tool_class=exec **manual_chat 专属**：邮件/定时触发的 run（S4）根本不注册这三个工具。执行在 Python
# serve-api /api/exec/*（业务权威 + 远程 parity）：固定 env 白名单基底（绝不继承 NOTION_TOKEN 等全局密钥）+
# inode 级 deny 地板（.env / *.db / token.dat / ssh key / app bundle 硬拒）+ 无 shell。由 Electron main 进程
# gateway 读（同上 openness flag，非 config.py pydantic，不加 vite define）。off → gateway 工具集字节级同 v1.2.0。
# MAILAGENT_OPENNESS_EXEC_TOOLS=true

# S2 skill 供应链 W4：skill 安装工具（E3 cutover 默认开 2026-07-06；显式 false 应急回退，安全地板不变：capability_change 恒 HITL）。开时 gateway 多 4 个工具：skill_install（两段式第一段：
# URL/本地包 → 隔离区 + preview，不安装）+ skill_install_confirm（第二段：服务端对隔离区**重算 hash** 比对
# preview 事实，不符 409 —— TOCTOU 兜底；审批卡按 quarantine_id 取**服务端事实**渲染，模型谎报包内容无效）
# + skill_uninstall（全清卸载：行+落盘目录+已存密钥，绝不走旧的仅删行 DELETE）+ skill_read（读已装 skill 的
# SKILL.md，恒 UNTRUSTED_SKILL_DOC 围栏 + 32KB 截断）。🔴 前三个 = edit-tier + tool_class=capability_change
# **恒人审**（改 agent 自身能力面：不吃 auto-reversible、不进结构化白名单、非 manual 会话不注册）；一次安装
# = 两张审批卡（批「去下载」+ 批「装这些文件」，ADR-002 §4）。下载复用 SSRF 硬化（钉 IP + 逐跳重校验 +
# 20MiB cap）+ 安全解包（zip-slip/symlink/炸弹防护）；执行期另有逐文件完整性 + 首跑闸（见 exec 工具 +
# /api/agent/policy/evaluate 前置 gate，宽白名单规则放行不了未首跑的 skill 脚本）。由 Electron main 进程
# gateway 读（同上 openness flag，非 config.py pydantic，不加 vite define）。off → gateway 工具集字节级同 v1.2.0。
# MAILAGENT_OPENNESS_SKILL_INSTALL=true

# prompt 文件路径（相对工作目录或绝对路径）；可按需改成自己的 md
# LLM_INBOX_PROMPT_PATH=prompts/email_inbox.md
# LLM_SENT_PROMPT_PATH=prompts/email_sent.md

# Email Agent Context Notion 页面 ID（留空则 prompt 里没有人物/项目/Sender Priority 上下文）
# LLM_CONTEXT_PAGE_ID=
# LLM_CONTEXT_CACHE_TTL_SEC=1800

# Daily Digest relation（留空则跳过写入 Daily Digests relation）
# LLM_DAILY_DIGEST_DATABASE_ID=
# LLM_DAILY_DIGEST_REPORT_DATE_PROP=Report Date

# 重试与正文截断
# LLM_MAX_RETRIES=3
# LLM_BODY_MAX_CHARS=12000

# Prompt Caching（仅 Anthropic 协议 / crs.chenge.ink 网关有效；其他 provider 请关）
# LLM_CACHE_ENABLED=true：在 system 末尾加 1 个 cache_control 断点，
#   服务端自动判 hit/write；不带状态，永远带即可。
# LLM_CACHE_TTL：'5m' / '1h'（默认 '1h'）/ 空串使用 Anthropic 默认 5m。
#   CRS Sonnet 不再搭配 anthropic-beta 头，避免触发账号级限流锁。
# 命中验证：对同一 internal_id 跑两次 run_llm_on_email.py --force，
#   第 2 次的 cache_read_input_tokens 应 > 0。
# LLM_CACHE_ENABLED=true
# LLM_CACHE_TTL=1h

# 启用模型白名单（逗号分隔），驱动 Custom AI Chat 模型 picker / 报告 agent 模型选择 /
# 邮件 AI 主·备模型三处选择列表。空或未配置 → 三处均 fallback 到内置默认模型列表。
# 该 key 由设置页 AI tab 的"启用模型列表"多选框维护（勾选即写入，无需重启即生效）。
# LLM_ENABLED_MODELS=claude-sonnet-4-6,claude-opus-4-8,claude-fable-5,gpt-5.5

# =============================================================================
# 其他配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/sync.log
SYNC_STORE_DB_PATH=data/sync_store.db
MAX_ATTACHMENT_SIZE=20971520


# ============================================================
# v4 SQLite SSoT 配置（邮件正文 + 附件元数据进 SQLite）
# 详见 docs/architecture_v4_sqlite_ssot.md
# ============================================================
# 是否双写邮件正文 + 附件到 SQLite（v4 架构）
# 失败仅 warning，不阻断 Notion sync 主流程
BODY_DUAL_WRITE_ENABLED=true

# 附件本地落盘目录（按 internal_id 分子目录）
ATTACHMENT_STORAGE_DIR=data/attachments

# Phase 2: LLM 优先从 SQLite 读 markdown body（v4 SSoT）；
# false 时退回 v3 正则剥 HTML（影响 LLM 分类标签口径，详见 docs/phase2-complete.md §3）
LLM_PREFER_SQLITE_BODY=true

# Phase 4 灰度开关：create_email_page_v2 是否优先走 SQLite SSoT 路径
# 默认灰度期 false；切 true 后正常 sync + resync 都走 create_email_page_from_sqlite
# miss 时自动 fallback 老路径。切 true 前请按 docs/phase4-complete.md §6 至少 3 封实测。
# NOTION_READ_FROM_SQLITE=false

# T7 CJK 中文分词（并行 trigram 表，DB v24）灰度开关
# 默认 false —— 关闭时搜索逐字节同现状（unicode61 + smart_query_transform 字符级 AND fallback）。
# 切 true 后裸全文中文 term 走 trigram 路由：>=3 字 MATCH / =2 字 trigram 表 LIKE 兜底 / 1 字拦截 + warning；
# 中英混合按 term 拆（英文 unicode61 候选 ∩ 中文 trigram 候选）。英文/列级 FTS/附件融合不变。
# 需先跑 DB v24 迁移建表（CREATE ... IF NOT EXISTS + 幂等回填）。详见 docs/reference/search/search-query-syntax.md §9。
# SEARCH_TRIGRAM_ENABLED=false

# ============================================================
# Sprint 15: SQLite SSoT inversion (email_outbox + FanoutWorker)
# E2-B (2026-07) 起 outbox 恒启用（灰度永久化, 总开关 MAILAGENT_OUTBOX_ENABLED
# 退役）: 所有 mutating 写恒走 SQLite intent + outbox, mail-sync 进程内
# FanoutWorker 主循环消费派发到 Mail.app + Notion。以下为调参项。
# ============================================================
# FanoutWorker poll 间隔（秒）—— 默认 5 秒一轮拉 pending outbox
# MAILAGENT_OUTBOX_POLL_INTERVAL_SEC=5

# 单条 outbox 重试次数上限；达到后晋升 dead_letter + 飞书告警
# 与 sync_store / LLMProcessingStore 退避一致 (60/300/900/3600/7200s)
# MAILAGENT_OUTBOX_MAX_ATTEMPTS=5

# FanoutWorker tick 内最大并发 fanout 数（asyncio.Semaphore）
# MAILAGENT_OUTBOX_CONCURRENCY=3

# =============================================================================
# CLI 写命令鉴权（docs/agent-cli-rfc.md §5.3）
# =============================================================================
# 服务端 token。设置后，CLI 写命令（email resync / notion update-flag 等）必须
# 经 --api-key 传同值。前端 Electron 走 keytar 存这个 key，IPC handler 转发。
# 留空 = 不启鉴权（dev 模式适用，生产强烈建议设）
# MAILAGENT_CLI_API_KEY=

# Dev 模式逃生口：服务端未设 key 时显式放行写命令
# 默认 false；仅本地开发临时用，**严禁** 上服务
# MAILAGENT_CLI_ALLOW_UNAUTH_WRITES=false

# =============================================================================
# 灵动岛 Plugin（Island-Sprint 2，frontend/ISLAND-PLUGIN.md，默认关闭）
# =============================================================================
# 启用前提：
#   1) 已装 ping-island.app fork （feat/mail-brand 分支，Phase 1 已 ship）
#   2) Swift 端 socket /tmp/island.sock 已 ready（启动 ping-island.app 后自动建）
#   3) 首次启用自动 bootstrap ~/.mailagent/plugins/ping_island/ 下的
#      manifest.json + locales/{zh-CN,en-US}/island.json（已存在则不覆盖）
#
# 失败模式：fail-open —— ping-island 未跑 / sleep 期间 / Swift 端崩，主同步不受影响。

# 总开关（必须显式打开）
# PING_ISLAND_ENABLED=false

# Swift daemon 监听的 unix socket 路径
# ISLAND_SOCKET_PATH=/tmp/island.sock

# connect / sendall / recv 三阶段共享超时（秒，REVIEW-LOG H-16）
# ISLAND_SOCKET_TIMEOUT=3.0

# envelope title/preview i18n：system（跟随 $LANG）/ zh-CN / en-US
# PING_ISLAND_LANG=system

# sleep/wake 后 socket 文件消失的探测间隔（秒，REVIEW-LOG H-17）
# PING_ISLAND_RECONNECT_PROBE_INTERVAL=300

# 发送失败时 backlog queue 上限（超出丢老的）
# PING_ISLAND_QUEUE_MAX=20

# 灵动岛主题色（前端 DESIGN.md §2.7 六色之一）：coral / cobalt / teal / rose / slate / olive
# ISLAND_ACCENT=coral

# light / dark mode（envelope metadata 透传给 Swift 渲染层）
# ISLAND_THEME=dark

# 邮件通知上岛范围（默认 important）：
#   important = 仅 AI 判定重要及以上级别弹卡 —— 每封新邮件的 MailReceived 一律静默
#               （该时点尚无 AI priority），LLM 结果仅 🔴 紧急 / 🟡 重要 弹卡
#               （紧急+需操作走带按钮 Urgent 卡、其余走普通卡，分流不变）
#   all       = 每封新邮件 + 全部 LLM 结果都弹（旧行为回退开关）
# 非邮件卡（日历 / DeadLetter 告警 / agent 审批等）不受影响。
# ISLAND_MAIL_NOTIFY_SCOPE=important

# 灵动岛 harness agent 上岛（Part B，默认关，需 ping_island 也开）
# 开时前端 chat 多轮 agent（AI SDK Gateway）需审批的写工具会把审批卡推上灵动岛，岛上点批准经
# 解耦 ack 通道触发 gateway 服务端 resume —— 用户完全离开 app（chat 面板没开）也能执行工具。
# 详见 docs/plans/agent-experience-epic/harness-island-integration-design.md
# MAILAGENT_ISLAND_AGENT_ENABLED=false

# 灵动岛 Phase 3 DailyDigest（每日巡检，默认关闭，需 ping_island 也开）
# 总开关：每天定时做一次跨邮件巡检 → 推一条"今日总结"到灵动岛
# MAILAGENT_DAILY_DIGEST_ENABLED=false

# 触发钟点（北京时区，逗号分隔小时）
# MAILAGENT_DAILY_DIGEST_HOURS=9,18

# 回看窗口小时数（取最近 N 小时邮件做汇总）
# MAILAGENT_DAILY_DIGEST_WINDOW_HOURS=24

# 单次 digest 喂给 LLM 的邮件 brief 封数上限（按 priority/date 排序取前 N）
# MAILAGENT_DAILY_DIGEST_MAX_EMAILS=50

# 每个 bulk action 携带的 internal_id 列表上限（单次一键批量处理封数）
# MAILAGENT_DAILY_DIGEST_MAX_BULK_IDS=30

# ── 报告 Agent 系统（src/reports；日/周/月报，默认关）──
# 总开关：常驻 report_worker 定时按 report_agent 表配置生成结构化报告
# （ReportDoc 块模型，前端 Agents 页查看）。独立于 island；per-agent 还需
# report_agent.enabled（默认种子 daily_email_digest enabled=0）。
# MAILAGENT_REPORT_AGENT_ENABLED=false

# 单次报告喂给 LLM 的邮件 brief 封数上限（按 priority/date 排序取前 N）
# MAILAGENT_REPORT_MAX_EMAILS=80

# ── Custom Agent 内核 + 产品化（src/agents，S4+S5；E3 cutover 默认开 2026-07-06）──
# 总开关：cron / email_filter 触发的 custom agent（type='custom' 行）→ headless run。
# 显式 false 应急回退 → new_watcher 第 5 hook 不 fire、AgentTriggerWorker 不启、agent_run 触发/入队全灭
# （字节级回 S3 终态）。per-agent 还需 report_agent.enabled + type='custom'（由 owner 创建）。
# S5 起本 flag 还门控产品面：Settings 建/改/看 custom agent + run 历史、对话式 CRUD 六工具
# （custom_agent_*，off 不注册）、per-agent「全自动」免卡白名单（domain_write/exec）、岛结果
# 通知。**on 但不配 grant/规则 = 恒 HITL**（per-agent opt-in = 天然开关）；per-agent exec
# 免卡额外叠加依赖下方 MAILAGENT_OPENNESS_EXEC_TOOLS。项目周报 S5 迁进本框架专型行（DB v31），
# 但总闸仍是 PROJECT_PROGRESS_SYNC_ENABLED（见上），不受本 flag 门控。
# MAILAGENT_CUSTOM_AGENTS_ENABLED=true

# =============================================================================
# 前端自动更新（feat/auto-update，frontend Electron app，v1.0.0 起 packaged 默认开）
# =============================================================================
# 主开关：gate 的是「自动后台下载 + 自动安装」（48h 周期复查 + 检测提醒不受 gate，见下）。
# gate 的只有"自动后台下载 + 自动安装"；检测/提醒不需签名（启动 10s 一次 check + 48h 周期
# 复查无条件 arm），Settings 里手动检查/下载/安装也照常。
# P6 (1.0.0) 已完成 Developer ID Application 签名 + notarytool 公证（electron-builder.yml
# mac.notarize:true + afterPack CSC_LINK 门控），与本 flag 同一次提交落地（铁律：运行时
# enabled 不校验真实签名态，安全靠此纪律）。故 readMasterFlag() 现在**打包态默认 ON、dev
# 默认 OFF**（frontend updater.ts）——正常发布无需在此显式设。下行仅用于 dogfood 提前开 /
# emergency 回滚关：
# AUTO_UPDATE_ENABLED=0    # 设 0 关自动下载/安装（仍保留检测提醒）；设 1/true 强制开

# =============================================================================
# V2 远程访问 (本地 FastAPI serve-api + Cloudflare Access)
# 详见 docs/v2-deployment-runbook.md + frontend/REMOTE-ACCESS.md §6
# `mailagent serve-api` 起 uvicorn @ 127.0.0.1:8200，经 cloudflared tunnel 暴露
# 给 https://mail.chenge.ink。改这一段后 **必须重启 serve-api**（auth.py 在 import
# 期读 env，非热加载）。
# =============================================================================

# serve-api uvicorn 端口（host 由子命令硬绑 127.0.0.1，不可改）。
# 必须与 cloudflared config.yml 的 ingress service 端口一致 — 改端口要两处同步。
# MAILAGENT_API_PORT=8200

# CF Zero Trust team domain（CF_ISSUER = https://<此值> 派生，不单独配 CF_ISSUER）。
# 默认值即此，多数情况不用改。
# CF_TEAM_DOMAIN=chenyq.cloudflareaccess.com

# 【生产必填】CF Access Application Audience (AUD) Tag — 从 Zero Trust dashboard
# 该 application 的 Overview/Settings 复制（一串 hex）。
# 留空且未开 MAILAGENT_API_AUTH_DISABLED → auth.py 启动即 RuntimeError 拒起
# （fail-fast：漏配会导致每个请求静默 403，难诊断）。
CF_AUDIENCE=

# 可选：追加 L2 二次校验白名单（逗号分隔，支持多个邮箱）。与 USER_EMAIL 取并集。
# 典型场景：邮箱迁移期两个邮箱并行放行（USER_EMAIL=新邮箱，此处填旧邮箱）。
# 示例：MAILAGENT_API_ALLOWED_EMAIL=lucien.chen@tp-link.com,another@example.com
# MAILAGENT_API_ALLOWED_EMAIL=

# --- 以下三项仅本地 dev:web 用；生产必须全部保持 false / 未设 ---------------
# 仅控制是否把 localhost:5173 加进 CORS 白名单（app.py）。生产关。
# MAILAGENT_API_DEV_CORS=false

# 仅控制是否跳过 CF Access JWT 校验（auth.py）。生产关。
# 设 true 必须同时 MAILAGENT_API_DEV=true，否则模块加载即 RuntimeError（防生产误关鉴权）。
# MAILAGENT_API_AUTH_DISABLED=false

# 显式 dev 上下文标记，仅在配合 MAILAGENT_API_AUTH_DISABLED=true 时需要。生产关。
# MAILAGENT_API_DEV=false

# 注：MAILAGENT_API_HOST 不在此配 — serve-api 子命令在 uvicorn.run 前硬写
# 127.0.0.1 到 environ，供 app.py loopback 断言二次兜底，用户不应手动设。

# =============================================================================
# Webhook Server 看板（远程 dashboard，可选）
# =============================================================================
# 看板登录密码。留空则禁用 /dashboard 入口（API 端点不受影响）
# DASHBOARD_PASSWORD=

# =============================================================================
# Jarvis KOS v2 集成（Sprint 19 M2 PR-2c+，默认关闭）
# =============================================================================
# OAuth 2.1 client_credentials + MCP JSON-RPC over HTTP (with SSE response).
# 2026-05-17 §6.28 cutover 后老 KOS-v1 KOS_API_KEY plaintext bearer 退役;
# 现在走 OAuth /token → 1h access_token (无 refresh, 401 重换) → POST /mcp
# tools/call. 凭据本地源 ~/.gbrain/oauth-clients/mailagent.json (mode 600).
# 完整 wire spec: mac mini docs/EXTERNAL-CLIENTS-MCP-WIRE-HANDOFF.md

# KOS 公网 MCP endpoint
# KOS_MCP_BASE=https://kos.chenge.ink

# OAuth client_id (gbrain_cl_... 前缀, 跟 Lucien 申请). 别 commit 实际值
# KOS_OAUTH_CLIENT_ID=gbrain_cl_xxxxxxxxxxxxxxxxxxxxxxxx

# OAuth client_secret (gbrain_cs_... 前缀). 别 commit 实际值 — 走 .env.local
# KOS_OAUTH_CLIENT_SECRET=gbrain_cs_xxxxxxxxxxxxxxxxxxxxxxxx

# Producer (PR-2d) 总开关 — 邮件 sync 完是否异步推 KOS /ingest (默认 false)
# MAILAGENT_KOS_INGEST_ENABLED=false

# Producer priority floor — 仅推 AI 标记 ≥ 此优先级的邮件入 KOS
# 取值: critical / urgent / important / normal / low
# 默认 normal (低优先级 mailing list / 广告 / 系统通知不污染图谱)
# KOS_INGEST_PRIORITY_FLOOR=normal

# Producer dry-run — 跑完整 payload builder + 不真发 /ingest (灰度用)
# KOS_INGEST_DRY_RUN=false

# Consumer (PR-2e) 总开关 — chat agent kos_query / kos_digest tool 是否启用
# MAILAGENT_KOS_CONSUMER_ENABLED=false

# Timeout (秒) — client 单次 fetch 超时
# KOS_TIMEOUT_SECONDS=10

# ============================================================
# Chat Agent (serve-api GET /api/chat/config 暴露给 chat 引擎 = embedded AI SDK Gateway)
# S3 (07-02): legacy TS harness 已删除, MAILAGENT_AGENT_HARNESS 随之退役。
# ============================================================
# agent 每条消息最大迭代次数
# AGENT_MAX_ITER=8
# agent 每轮成本上限 USD
# AGENT_MAX_COST_USD=0.5
# Standing Context 分层 prompt (Phase -1/0A): 不可弱化 PRODUCT_SAFETY_FLOOR + SOUL/AGENT/RULES/USER
# (backend agent_config.db 组装)。默认 ON; 设 false 回退旧 SOUL_MARKDOWN (字节一致, 应急回切)。
# MAILAGENT_STANDING_CONTEXT_ENABLED=true
# backend-owned agent_config.db 路径覆盖 (默认 sync_store 同目录); 不进 DB_VERSION, 镜像 api_keys
# MAILAGENT_AGENT_CONFIG_DB_PATH=
# L1 hot block: chat start 按发件人预取 KOS digest 注入 system prompt
# MAILAGENT_KOS_L1_HOT_BLOCK_ENABLED=false
# kos_query 命中 14d 半衰期时间衰减 rerank (false → 纯服务端 bm25 序)
# MAILAGENT_KOS_TIME_DECAY_ENABLED=true
# ── embedded AI SDK Gateway (S3 后唯一 chat 引擎, 无条件启动) ──
# Electron main 内嵌 loopback Node HTTP server (/health + /api/ai/config + /api/ai/chat —
# streamText → AI SDK UIMessage 流)。createWindow 经 ?aiGatewayPort= 把端口注入 renderer;
# 远程 web 经 serve-api ai_gateway_proxy 同源代理。provider key 仅在 main (llm_settings),
# renderer 不接触。cutover 期的 MAILAGENT_AI_SDK_GATEWAY / MAILAGENT_A2UI_TOOL_CARDS /
# MAILAGENT_AI_SDK_CONTEXT_INJECTION / MAILAGENT_ASSISTANT_UI_PANEL / MAILAGENT_CHAT_RUNTIME /
# MAILAGENT_AI_SDK_NEW_SESSION_DEFAULT / MAILAGENT_AGENT_VIEW / MAILAGENT_ASSISTANT_MODAL
# 已全部 GA 移除 (行为硬编码 ON; 回退 = 装回旧版 .app)。
# 设计见 docs/reference/llm-agent/ai-sdk-gateway-architecture.md §13。
# Gateway 端口 (默认 8300, 避开 serve-api 8200 / 本地 SSE 9200)。
# MAILAGENT_AI_GATEWAY_PORT=8300
# 写工具 kill-switch (env-only, 默认 true)。false → Gateway 退回恒只读 (5 个 preview/edit 写工具
# email_flag/archive/pin/draft_reply/resync 不注册, email_prepare_send 也随之消失——它挂在写工具
# 集合下)。开着时写工具全部 needsApproval (HITL 两次调用), 经 MailAgentDomainClient → serve-api
# 写端点 (Python MailWriteService 二次鉴权), 叠加 domain ApprovalGuard (id/hash/expiry)。
# MAILAGENT_AI_SDK_WRITE_TOOLS=true
# 高风险外发工具 kill-switch (env-only, 默认 true; server-only, 无 renderer 镜像)。false → 不注册
# email_prepare_send (真发 SMTP 面独立关停, 与 blocking 恒审批双保险互补)。开着时该工具 blocking
# tier 永远 needsApproval, 绝不 auto-send: 首调出 SendApprovalCard (To/CC/BCC/Subject/Body 可编辑 +
# 外部收件人/敏感词 warning), 批准后二调才经双 guard 真实 SMTP 发送 —— Gateway: 审批存在/未过期/
# 已批/idempotency 一次性 + content hash 绑定; Python /api/email/send-approved: HMAC 令牌签名
# (共享 local API token)/未过期/payload hash 匹配/send ledger 未用/backend 支持 send。任一失败 →
# 邮件绝不发出。须与 _WRITE_TOOLS 同开才生效 (工具挂在写集合下)。
# MAILAGENT_AI_SDK_SEND_TOOL=true
# ── chat-panel P4 Phase 05 (AG-UI interop mirror, flag-off) ──
# AG-UI 互操作 mirror 总开关 (默认关, server-only — 无 renderer 镜像)。true → Gateway 多注册一个
# 旁路端点 POST /api/ai/agui/chat: 复用与 /api/ai/chat 完全相同的 streamText + tools + 04b 双 guard
# approval, 只把输出从 UIMessage 流换成标准 AG-UI event 流 (RUN_STARTED / STATE_SNAPSHOT /
# TEXT_MESSAGE_* / TOOL_CALL_* / RUN_FINISHED / RUN_ERROR; approval → CUSTOM Interrupt +
# requires-action)。供外部 agent client / CopilotKit / AG-UI 生态互操作, 不是产品 chat 主路径,
# 不影响 AI SDK runtime。STATE_SNAPSHOT 经脱敏 (不塞完整正文 / token·key 绝不进 state)。高风险外发
# 经 AG-UI interrupt 往返仍走 04b 双 guard (无静默外发路径)。flag-off → 路由不注册 (404)。设计见
# docs/plans/chat-panel-ai-sdk-assistant-ui-refactor/phase-05-ag-ui-interop.md + architecture.md §9/§13.13。
# MAILAGENT_AG_UI_MIRROR=false
# (S3: 上下文注入 [原 MAILAGENT_AI_SDK_CONTEXT_INJECTION] 已 GA 恒开 —— Gateway 恒注入
# systemPromptProvider: standingContext [SOUL+AGENT+RULES+USER, PRODUCT_SAFETY_FLOOR 恒最前] +
# userContext + memory + typed AgentContextSnapshot [UNTRUSTED_* 围栏]; /chat/config 取不到 →
# 降级 context-light, 绝不阻断对话。)

# ============================================================
# 进程护栏 (task 06-10 memleak/orphan — serve + serve-api 两入口生效)
# 三项均为直读 os.environ 的 env-only flag (不进 pydantic config, 见 main.py
# 顶部 load_dotenv 注释)。打包态由 Electron buildBaseEnv 注入; pm2/dev 通常
# 不设 —— 不设 = 完全禁用, 零行为变更。
# ============================================================
# 父进程死亡看门狗: =1 时 daemon 线程每 5s 检测 PPID==1 (Electron 父进程
# force-quit/crash → 被 launchd 收养) → 立即 os._exit(0), 防孤儿进程长期占
# 内存吃 CPU。pm2 模式勿设 (pm2 daemon 重启场景会误杀)。
# MAILAGENT_PARENT_WATCHDOG=1

# 内存水位自愈: 进程 RSS 超过该值 (MB) → ERROR 诊断 dump (tracemalloc 在跑
# 时含 top-20 分配栈 + RSS/traced gap 分析) + 优雅退出 + 60s 硬兜底
# os._exit(2) (Electron 侧崩溃自拉起, 重启即内存清零)。未设/非正整数 = 禁用。
# MAILAGENT_MEM_LIMIT_MB=4096

# 内存诊断: =1 时进程启动即 tracemalloc.start(10) (常驻 ~5-10% 内存开销,
# 默认关); mem guard 超限 dump 时才有 Python 分配栈可看。
# MAILAGENT_MEM_DIAG=1
