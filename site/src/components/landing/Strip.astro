---
/**
 * Strip — "what happens once an email lands": six labelled steps (triage,
 * summary, reply draft, matter link, contact filing, search index). Bordered
 * band between the hero and the first section. Icons map 1:1 to the YAML order.
 */
import Icon from './Icon.astro'
import type { IconName } from './icons'

interface Props {
  label?: string
  items?: string[]
}

const { label, items = [] } = Astro.props

const iconKeys: IconName[] = ['prioritize', 'summarize', 'draft', 'target', 'userPlus', 'search']
---

<section class="strip">
  <div class="wrap strip-inner">
    {label && <span class="strip-label">{label}</span>}
    <div class="strip-items">
      {
        items.map((item, i) => (
          <span>
            <Icon name={iconKeys[i] ?? 'categorize'} />
            {item}
          </span>
        ))
      }
    </div>
  </div>
</section>
