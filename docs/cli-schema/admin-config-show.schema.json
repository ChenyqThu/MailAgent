{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/admin-config-show.schema.json",
  "title": "mailagent admin config show",
  "description": "Sprint 15 Stage 3 — 反射 Settings 字段并输出 (敏感字段默认 mask, --show-secrets 需 auth)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "schema_version", "data", "meta"],
  "properties": {
    "status": {"const": "success"},
    "schema_version": {"type": "integer", "minimum": 1},
    "data": {
      "oneOf": [
        {"$ref": "#/$defs/all_settings"},
        {"$ref": "#/$defs/single_field"}
      ]
    },
    "meta": {"$ref": "_common.schema.json#/$defs/meta"}
  },
  "$defs": {
    "field_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_var", "value", "default", "description", "sensitive"],
      "properties": {
        "env_var": {"type": "string", "description": "环境变量名 (大写)"},
        "value": {
          "description": "字段当前值; 敏感字段被脱敏为 '***last4' 或 '<unset>'"
        },
        "default": {"description": "Settings 字段默认值"},
        "description": {"type": "string"},
        "sensitive": {"type": "boolean", "description": "true 表示 name 含 token/secret/password/api_key"}
      }
    },
    "all_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "count"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/field_entry"}
        },
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "single_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "env_var", "value", "default", "description", "sensitive"],
      "properties": {
        "key": {"type": "string"},
        "env_var": {"type": "string"},
        "value": {},
        "default": {},
        "description": {"type": "string"},
        "sensitive": {"type": "boolean"}
      }
    }
  }
}
