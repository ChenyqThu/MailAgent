{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/email-resync.schema.json",
  "title": "mailagent email resync",
  "description": "RFC v2 §4.2 / §7.3 — 单封邮件重传 plan / 结果 (PR-2 仅单封; PR-4 batch 走 partial_failure schema)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "schema_version", "data", "meta"],
  "properties": {
    "status": {"const": "success"},
    "schema_version": {"type": "integer", "minimum": 1},
    "data": {
      "oneOf": [
        {"$ref": "#/$defs/resync_plan"},
        {"$ref": "#/$defs/resync_result"}
      ]
    },
    "meta": {"$ref": "_common.schema.json#/$defs/meta"}
  },
  "$defs": {
    "resync_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_id", "dry_run", "action"],
      "properties": {
        "internal_id": {"type": "integer", "minimum": 0},
        "subject": {"type": "string"},
        "current_page_id": {"type": ["string", "null"]},
        "action": {"type": "string", "enum": ["create_or_skip", "replace"]},
        "would_replace": {"type": "boolean"},
        "skip_parent_lookup": {"type": "boolean"},
        "dry_run": {"const": true}
      }
    },
    "resync_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal_id", "action", "dry_run", "new_page_id", "old_page_id", "archived_page_id"],
      "properties": {
        "internal_id": {"type": "integer", "minimum": 0},
        "old_page_id": {
          "type": ["string", "null"],
          "description": "Notion 侧 dup 命中时返回的老页 id (优先), 否则取 sync_store 中本地缓存的 notion_page_id"
        },
        "new_page_id": {
          "type": ["string", "null"],
          "description": "本次实际生效的 Notion page id; skipped 时即 old page, created/replaced 时为新页"
        },
        "archived_page_id": {
          "type": ["string", "null"],
          "description": "仅在 --replace-existing 真正成功 archive 老页时填; 其他情况 (包括 replace+archive 失败) 为 null"
        },
        "action": {"type": "string", "enum": ["created", "replaced", "skipped"]},
        "dry_run": {"const": false},
        "attachments_uploaded": {"type": "integer"},
        "attachments_failed": {"type": "integer"},
        "thread_relations_updated": {"type": "boolean"}
      }
    }
  }
}
