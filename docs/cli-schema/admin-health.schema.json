{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/admin-health.schema.json",
  "title": "mailagent admin health",
  "description": "RFC v2 §4.8 — SQLite 连通性 + db_version + 表存在性快速检查",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "schema_version", "data", "meta"],
  "properties": {
    "status": {"const": "success"},
    "schema_version": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "db_path", "db_accessible", "db_version",
        "db_version_expected", "schema_ok",
        "tables_present", "tables_missing",
        "outbox_dispatch_enabled", "outbox_backlog", "healthy"
      ],
      "properties": {
        "db_path": {"type": "string"},
        "db_accessible": {"type": "boolean"},
        "db_version": {"type": ["integer", "null"]},
        "db_version_expected": {"type": "integer"},
        "schema_ok": {"type": "boolean"},
        "tables_present": {"type": "array", "items": {"type": "string"}},
        "tables_missing": {"type": "array", "items": {"type": "string"}},
        "outbox_dispatch_enabled": {"type": "boolean"},
        "outbox_backlog": {"type": "integer", "minimum": 0},
        "outbox_warning": {"type": "string"},
        "healthy": {"type": "boolean"},
        "error": {"type": "string"}
      }
    },
    "meta": {"$ref": "_common.schema.json#/$defs/meta"}
  }
}
