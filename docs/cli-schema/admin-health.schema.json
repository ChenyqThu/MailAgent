{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/admin-health.schema.json",
  "title": "mailagent admin health",
  "description": "RFC v2 §4.8 — SQLite 连通性 + db_version + 表存在性快速检查",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "schema_version", "data", "meta"],
  "properties": {
    "status": {"const": "success"},
    "schema_version": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "db_path", "db_accessible", "db_version",
        "db_version_expected", "schema_ok",
        "tables_present", "tables_missing", "healthy"
      ],
      "properties": {
        "db_path": {"type": "string"},
        "db_accessible": {"type": "boolean"},
        "db_version": {"type": ["integer", "null"]},
        "db_version_expected": {"type": "integer"},
        "schema_ok": {"type": "boolean"},
        "tables_present": {"type": "array", "items": {"type": "string"}},
        "tables_missing": {"type": "array", "items": {"type": "string"}},
        "healthy": {"type": "boolean"},
        "error": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "workers": {
          "description": "E4 WP1 — supervise 状态跃迁写的 worker 心跳 (sync_state 'worker.%' 键反解)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {"type": "string"},
              "last_started_at": {"type": "string"},
              "restart_count": {"type": ["integer", "string"]},
              "last_error": {"type": "string"},
              "stale": {"type": "boolean"}
            }
          }
        },
        "davmail": {
          "description": "E4 WP2 — DavMailWatchdog 落盘摘要; 非 davmail 模式为 null",
          "type": ["object", "null"],
          "properties": {
            "token_age_days": {"type": ["number", "null"]},
            "imap_reachable": {"type": "boolean"},
            "last_probe_at": {"type": ["string", "null"]}
          }
        }
      }
    },
    "meta": {"$ref": "_common.schema.json#/$defs/meta"}
  }
}
