{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/attachment-cleanup-orphans.schema.json",
  "title": "mailagent attachment cleanup-orphans",
  "description": "RFC v2 §4.3 — 扫盘上孤儿附件目录, 默认 --dry-run, --no-dry-run + --yes 才删.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orphans", "total_orphans", "total_size_bytes",
            "deleted", "dry_run", "mode"
          ],
          "properties": {
            "orphans": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "internal_id", "size_bytes", "file_count"],
                "properties": {
                  "path": {"type": "string"},
                  "internal_id": {"type": "integer", "minimum": 0},
                  "size_bytes": {"type": "integer", "minimum": 0},
                  "file_count": {"type": "integer", "minimum": 0},
                  "error": {"type": "string"}
                }
              }
            },
            "total_orphans": {"type": "integer", "minimum": 0},
            "total_size_bytes": {"type": "integer", "minimum": 0},
            "deleted": {"type": "integer", "minimum": 0},
            "dry_run": {"type": "boolean"},
            "mode": {"type": "string", "enum": ["dry-run", "deleted"]}
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "error", "meta"],
      "properties": {
        "status": {"const": "error"},
        "schema_version": {"type": "integer", "minimum": 1},
        "error": {"$ref": "_common.schema.json#/$defs/error"},
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    }
  ]
}
