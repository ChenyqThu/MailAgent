{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/admin-cleanup.schema.json",
  "title": "mailagent admin cleanup",
  "description": "RFC v2 §4.8 / PR-5 US-004 — admin cleanup-* inline schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schema_version",
        "data",
        "meta"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "required": [
            "action",
            "mode",
            "ok"
          ],
          "additionalProperties": true,
          "properties": {
            "action": {
              "type": "string"
            },
            "dry_run": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "mode": {
              "const": "inline"
            },
            "ok": {
              "type": "boolean"
            },
            "stdout_tail": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "meta": {
          "$ref": "_common.schema.json#/$defs/meta"
        }
      }
    },
    {
      "$ref": "_common.schema.json#/$defs/wrapper_error"
    }
  ]
}
