{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/notion-page-orphans.schema.json",
  "title": "mailagent notion page-orphans",
  "description": "RFC v2 §4.6 — 扫 Notion 邮件库有 page 但本地无 metadata; PR-5 支持 bounded repair.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orphans", "total_scanned", "total_orphans",
            "limit", "dry_run", "mode"
          ],
          "properties": {
            "orphans": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page_id"],
                "properties": {
                  "page_id": {"type": "string"},
                  "message_id": {"type": ["string", "null"]},
                  "subject": {"type": ["string", "null"]},
                  "notion_url": {"type": ["string", "null"]}
                }
              }
            },
            "total_scanned": {"type": "integer", "minimum": 0},
            "total_orphans": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1},
            "dry_run": {"const": true},
            "mode": {"const": "dry_run"}
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action", "repair_action", "command", "mode", "dry_run",
            "scanned", "orphans_found", "limit", "max_pages",
            "archived", "failed"
          ],
          "properties": {
            "action": {"const": "archive"},
            "repair_action": {"const": "archive"},
            "command": {"const": "page-orphans"},
            "mode": {"const": "inline"},
            "dry_run": {"const": false},
            "scanned": {"type": "integer", "minimum": 0},
            "orphans_found": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1},
            "max_pages": {"type": "integer", "minimum": 1},
            "archived": {
              "type": "array",
              "items": {"type": "string"}
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page_id", "error"],
                "properties": {
                  "page_id": {"type": "string"},
                  "error": {"type": "string"}
                }
              }
            }
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action", "repair_action", "command", "mode", "dry_run",
            "scanned", "orphans_found", "limit", "max_pages",
            "archived", "failed"
          ],
          "properties": {
            "action": {"const": "insert-stub"},
            "repair_action": {"const": "insert-stub"},
            "command": {"const": "page-orphans"},
            "mode": {"const": "inline"},
            "dry_run": {"const": false},
            "scanned": {"type": "integer", "minimum": 0},
            "orphans_found": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1},
            "max_pages": {"type": "integer", "minimum": 1},
            "archived": {
              "type": "array",
              "items": {"type": "string"}
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["page_id", "error"],
                "properties": {
                  "page_id": {"type": "string"},
                  "error": {"type": "string"}
                }
              }
            }
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "error", "meta"],
      "properties": {
        "status": {"const": "error"},
        "schema_version": {"type": "integer", "minimum": 1},
        "error": {"$ref": "_common.schema.json#/$defs/error"},
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    }
  ]
}
