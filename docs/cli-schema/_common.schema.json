{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/_common.schema.json",
  "title": "MailAgent CLI Common Wrapper",
  "description": "顶层 wrapper / error / meta 通用结构 (RFC v2 §5.1.2 / §7.0). 根 schema 用 oneOf 校验 status ∈ {success, error, partial_failure} 三种 wrapper 之一。",
  "oneOf": [
    {"$ref": "#/$defs/wrapper_success"},
    {"$ref": "#/$defs/wrapper_error"},
    {"$ref": "#/$defs/wrapper_partial_failure"}
  ],
  "$defs": {
    "wrapper_success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {},
        "meta": {"$ref": "#/$defs/meta"}
      }
    },
    "wrapper_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "error", "meta"],
      "properties": {
        "status": {"const": "error"},
        "schema_version": {"type": "integer", "minimum": 1},
        "error": {"$ref": "#/$defs/error"},
        "meta": {"$ref": "#/$defs/meta"}
      }
    },
    "wrapper_partial_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "partial_failure"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "required": ["succeeded", "failed", "summary"],
          "properties": {
            "succeeded": {"type": "array"},
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["error"],
                "properties": {
                  "internal_id": {"type": ["integer", "null"]},
                  "error": {"$ref": "#/$defs/error"}
                }
              }
            },
            "summary": {
              "type": "object",
              "required": ["total", "succeeded", "failed"],
              "properties": {
                "total": {"type": "integer"},
                "succeeded": {"type": "integer"},
                "failed": {"type": "integer"},
                "aborted_by": {"type": ["string", "null"]}
              }
            }
          }
        },
        "meta": {"$ref": "#/$defs/meta"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "machine-readable enum, see error-codes.md"
        },
        "message": {"type": "string"},
        "hint": {"type": "string"},
        "context": {"type": "object"}
      }
    },
    "meta": {
      "type": "object",
      "required": ["duration_ms"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "total_hits": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "query": {"type": "string"},
        "parse_warnings": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Search Query DSL parser warnings; omitted when empty."
        }
      }
    },
    "iso_datetime_or_date": {
      "type": ["string", "null"],
      "description": "ISO 8601 datetime (含时区优先) 或 YYYY-MM-DD HH:MM:SS / null"
    },
    "sync_status": {
      "type": ["string", "null"],
      "enum": ["pending", "fetch_failed", "synced", "failed", "skipped", "dead_letter", "deleted", null]
    }
  }
}
