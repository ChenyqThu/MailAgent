{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/attachment-derive.schema.json",
  "title": "mailagent attachment derive",
  "description": "RFC v2 §4.3 — derive Office 衍生附件. PR-3 仅 dry-run stub; 实跑实现在 PR-4 'backfill derivatives'.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["internal_id", "stub", "message"],
          "properties": {
            "internal_id": {"type": "integer", "minimum": 0},
            "stub": {"const": true},
            "message": {"type": "string"},
            "current_workaround": {"type": "string"}
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "error", "meta"],
      "properties": {
        "status": {"const": "error"},
        "schema_version": {"type": "integer", "minimum": 1},
        "error": {"$ref": "_common.schema.json#/$defs/error"},
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    }
  ]
}
