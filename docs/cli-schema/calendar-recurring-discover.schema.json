{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mailagent.local/cli-schema/calendar-recurring-discover.schema.json",
  "title": "mailagent calendar recurring discover",
  "description": "RFC v2 §4.10 — 扫 SyncStore 找带 RRULE 的会议邀请 (read-only).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "data", "meta"],
      "properties": {
        "status": {"const": "success"},
        "schema_version": {"type": "integer", "minimum": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "series", "total_series", "matches_total",
            "scanned", "since", "limit"
          ],
          "properties": {
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["series_uid", "internal_ids"],
                "properties": {
                  "series_uid": {"type": "string"},
                  "master_dtstart": {"type": ["string", "null"]},
                  "summary": {"type": ["string", "null"]},
                  "sender": {"type": ["string", "null"]},
                  "organizer": {"type": ["string", "null"]},
                  "rrule": {"type": ["string", "null"]},
                  "method": {"type": ["string", "null"]},
                  "internal_ids": {
                    "type": "array",
                    "items": {"type": "integer", "minimum": 0}
                  }
                }
              }
            },
            "total_series": {"type": "integer", "minimum": 0},
            "matches_total": {"type": "integer", "minimum": 0},
            "scanned": {"type": "integer", "minimum": 0},
            "since": {"type": ["string", "null"]},
            "limit": {"type": "integer", "minimum": 1}
          }
        },
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_version", "error", "meta"],
      "properties": {
        "status": {"const": "error"},
        "schema_version": {"type": "integer", "minimum": 1},
        "error": {"$ref": "_common.schema.json#/$defs/error"},
        "meta": {"$ref": "_common.schema.json#/$defs/meta"}
      }
    }
  ]
}
